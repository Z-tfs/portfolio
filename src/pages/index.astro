---
// 根路径：按浏览器语言跳转到 /en/ 或 /zh/，其他语言默认 /en/
import { url } from '../i18n/utils';
const en = url('en/');
const zh = url('zh/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Archive (ZQ)</title>
    <link rel="alternate" hreflang="en" href={en} />
    <link rel="alternate" hreflang="zh-Hans" href={zh} />
    <script is:inline define:vars={{ en, zh }}>
      var target = en;
      var list = navigator.languages || [navigator.language || ''];
      for (var i = 0; i < list.length; i++) {
        var l = String(list[i]).toLowerCase();
        if (l.indexOf('zh') === 0) { target = zh; break; }
        if (l.indexOf('en') === 0) { target = en; break; }
      }
      location.replace(target + location.search + location.hash);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${en}`} /></noscript>
    <style>html { background: #000; color: #e8e8e8; }</style>
  </head>
  <body>
    <p><a href={en}>English</a> / <a href={zh}>中文</a></p>
  </body>
</html>
